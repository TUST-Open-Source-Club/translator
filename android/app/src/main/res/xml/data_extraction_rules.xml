<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the gigabytes of models (re-downloadable) out of cloud
     backups and device-to-device transfers; history and settings still move -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="home/.mkshrc" />
        <include domain="file" path="home/.mksh_history" />
        <include domain="file" path="home/.profile" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="home/.mkshrc" />
        <include domain="file" path="home/.mksh_history" />
        <include domain="file" path="home/.profile" />
    </device-transfer>
</data-extraction-rules>
